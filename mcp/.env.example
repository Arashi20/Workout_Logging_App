# Same database as the main app - copy Railway's reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:5432/railway

# Must match the main app: OAuth logins are checked against its users table,
# and tokens are signed with this key.
SECRET_KEY=same-secret-key-as-the-main-app
ADMIN_USERNAME=your-username
ADMIN_PASSWORD=your-password

# Public https URL of THIS service (Railway fills RAILWAY_PUBLIC_DOMAIN in itself)
MCP_PUBLIC_URL=https://your-mcp-service.up.railway.app

# Host header allow-list (comma separated). Leave empty to accept any host.
MCP_ALLOWED_HOSTS=your-mcp-service.up.railway.app

# Optional pre-shared OAuth client, if you would rather paste credentials into
# Claude than let it register itself.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=

# Optional static bearer token for curl / Claude Code
API_READ_TOKEN=
